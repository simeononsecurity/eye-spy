
# PlatformIO build artifacts
.pio/

# platformio-mcp tool workspace (build logs, task registry, audit trail)
.pio-mcp-workspace/

# IDE settings
.vscode/

# macOS junk
.DS_Store

# SPIFFS runtime session files (written by firmware to the ESP32 filesystem,
# never source-controlled — they contain field detection data)
session.json
session.tmp
prev_session.json

# Python bytecode (api/eyespy.py is run directly, so __pycache__/ appears as
# soon as it or any helper module is imported)
__pycache__/
*.pyc

# Flask API runtime output. The README's quick start runs from api/, so this
# lands there: data/ holds the pickled detection store (eye-spy streams its
# CSV/JSON/KML exports in memory, so there is no exports/ dir). Contains field
# detection data — never source-controlled.
api/data/
